---
import { site, reviews } from '../data/site.js';
import {
  organizationNode, personNode, websiteNode, webPageNode, ORG, WEBSITE,
} from '../utils/schema.js';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChatBot from '../components/ChatBot.astro';
import '../styles/global.css';

const {
  title,
  description,
  ogImage = '/images/og-default.jpg',
  schema = [],          // page-specific JSON-LD nodes (no @context — see utils/schema.js)
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const isHome = Astro.url.pathname === '/';

// ---------------------------------------------------------------------
// Review markup is scoped to the two pages actually ABOUT the business.
// Google: an entity's own site is ineligible for the star review feature,
// so this never produces stars — it is kept for AI/LLM readers. Emitting
// it on /privacy-policy/ and /404/ would read as blanket stuffing.
// ---------------------------------------------------------------------
const reviewPages = ['/', '/about', '/about/'];
const showReviews = reviewPages.includes(Astro.url.pathname);
const realReviews = showReviews ? reviews.filter((r) => r.real) : [];

// ---------------------------------------------------------------------
// THE @graph
//
// The business entity is DEFINED once, on the homepage. Every other page
// emits only a reference to it ({ "@id": ORG }) plus its own page nodes.
// One company, 86 pages — instead of 86 rival copies of one company.
// ---------------------------------------------------------------------
const pageNode = webPageNode({
  url: canonical,
  name: title,
  description,
  image: new URL(ogImage, site.url).href,
  // If the page defines a Service, the page is ABOUT that service.
  about: (schema.find((n) => n && n['@type'] === 'Service') || {})['@id'],
});

// Stamp @id / isPartOf onto page nodes that don't carry their own, so every
// node in the graph is addressable and tied back to this page.
const pageNodes = schema.filter(Boolean).map((node) => {
  const out = { ...node };
  if (!out['@id']) {
    const t = Array.isArray(out['@type']) ? out['@type'][0] : out['@type'];
    out['@id'] = `${canonical}#${String(t).toLowerCase()}`;
  }
  if (!out.isPartOf) out.isPartOf = { '@id': pageNode['@id'] };
  return out;
});

const graph = [
  // Defined in full on the homepage; referenced by @id everywhere else.
  isHome ? organizationNode(realReviews) : { '@type': 'PavingContractor', '@id': ORG },
  ...(isHome ? [personNode(), websiteNode()] : [{ '@type': 'WebSite', '@id': WEBSITE }]),
  pageNode,
  ...pageNodes,
];

// /about/ is the one non-home page that still carries the reviews.
if (!isHome && realReviews.length > 0) {
  graph[0] = organizationNode(realReviews);
}

const jsonld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })
  // Prevents a literal </script> inside any string from closing the tag early.
  .replace(/</g, '\\u003c');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    {site.searchConsoleToken && <meta name="google-site-verification" content={site.searchConsoleToken} />}

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, site.url).href} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Fonts: two families, swap display, preconnected -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Rubik:wght@400;500;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Rubik:wght@400;500;600;700&display=swap" /></noscript>

    <script type="application/ld+json" is:inline set:html={jsonld} />

    {site.ga4Id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4Id}`}></script>
        <script
          set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${site.ga4Id}');`}
          defer
        />
      </>
    )}

    {site.clarityId && (
      <script
        set:html={`(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script","${site.clarityId}");`}
      />
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!-- Sticky mobile call bar -->
    <nav class="callbar" aria-label="Quick contact">
      <a class="call" href={site.phoneHref} data-track="call">📞 Call Now</a>
      <a class="quote" href="/free-quote/">Get a Free Quote</a>
    </nav>

    <ChatBot />

    <!-- Conversion tracking: click-to-call taps fire a GA4 event -->
    <script>
      document.addEventListener('click', (e) => {
        const a = e.target.closest('a[href^="tel:"]');
        if (a && typeof window.gtag === 'function') {
          window.gtag('event', 'phone_call', {
            event_category: 'conversion',
            event_label: location.pathname,
          });
        }
      });
    </script>
  </body>
</html>
